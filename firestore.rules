rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isValidTask(request.resource.data);
      allow update: if request.auth != null && isValidTask(request.resource.data);
      allow delete: if request.auth != null;
    }

    function isValidTask(data) {
      return data.keys().hasOnly([
          'title',
          'description',
          'owner',
          'status',
          'start_date',
          'end_date',
          'created_at',
          'updated_at'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && (!('description' in data) || data.description is string)
        && (!('owner' in data) || data.owner is string)
        && data.status in ['todo', 'in_progress', 'done', 'closed']
        && data.start_date is string
        && data.end_date is string
        && data.end_date >= data.start_date;
    }
  }
}
